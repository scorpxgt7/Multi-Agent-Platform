{
  "name": "multi-agent-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "node backend/server.js",
    "validate:backend": "node backend/server.js --validate",
    "smoke:backend": "node backend/smoke_check.js",
    "smoke:frontend": "node scripts/smoke-frontend.mjs",
    "smoke:release": "npm run build && npm run smoke:frontend",
    "build": "vite build && node scripts/write-build-index.mjs dist && node scripts/sync-root-assets.mjs dist/assets assets",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  }
}
