HOST=0.0.0.0
PORT=8787
PUBLIC_APP_URL=http://staging.your-domain.example/
CORS_ALLOWED_ORIGINS=
NEXUS_ENGINE=local-simulation
NEXUS_API_KEY=replace-with-a-strong-secret
NEXUS_PERSISTENCE_MODE=postgres
MAINTENANCE_AUTORUN=true
MAINTENANCE_DAILY_UTC=06:00
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

POSTGRES_DB=multi_agent
POSTGRES_USER=multi_agent
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

NGINX_PORT=8081
API_GATEWAY_URL=http://api-gateway:8080
SKILL_SERVICE_URL=http://skill-service:8101
AGENT_SERVICE_URL=http://agent-service:8102
POLICY_SERVICE_URL=http://policy-service:8103
ORCHESTRATOR_SERVICE_URL=http://orchestrator-service:8105
MEMORY_SERVICE_URL=http://memory-service:8104

EVENT_CHANNEL=multi-agent-events

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
API_GATEWAY_REQUEST_TIMEOUT=30

MAINTENANCE_AUTORUN=true
BACKUP_PATH=/var/backups/multi-agent
