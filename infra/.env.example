COMPOSE_PROJECT_NAME=multi-agent-platform

POSTGRES_DB=multi_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://postgres:change-me@postgres:5432/multi_agent

REDIS_URL=redis://redis:6379/0
EVENT_CHANNEL=multi-agent-events
VECTOR_BACKEND=pgvector

NGINX_PORT=8080
SKILL_SERVICE_PORT=8101
AGENT_SERVICE_PORT=8102
POLICY_SERVICE_PORT=8103
MEMORY_SERVICE_PORT=8104
ORCHESTRATOR_SERVICE_PORT=8105
API_GATEWAY_PORT=8080

SKILL_SERVICE_URL=http://skill-service:8101
AGENT_SERVICE_URL=http://agent-service:8102
POLICY_SERVICE_URL=http://policy-service:8103
MEMORY_SERVICE_URL=http://memory-service:8104
ORCHESTRATOR_SERVICE_URL=http://orchestrator-service:8105
