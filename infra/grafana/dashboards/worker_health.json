{
  "dashboard": {
    "id": null,
    "uid": "worker-health",
    "title": "Worker Health",
    "schemaVersion": 37,
    "version": 1,
    "refresh": "15s",
    "panels": [
      {
        "type": "timeseries",
        "title": "Active Workers",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          { "expr": "workflow_worker_count", "refId": "A" }
        ]
      },
      {
        "type": "timeseries",
        "title": "Worker Errors",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          { "expr": "workflow_worker_errors_total", "refId": "A" }
        ]
      }
    ]
  },
  "overwrite": false
}
